float4 PS_BlurH(PS_INPUT IN) : COLOR0
{
	float4 result = float4(0, 0, 0, 0);

	float2 size = cvBloomParams.zw;

	for (int i = 0; i < 32; ++i)
	{
		result += tex2D(DIFFUSEMAP_SAMPLER, IN.uv + float2(OFFSETS[i], 0) / size) * WEIGHTS[i];
	}

	return result;
}

float4 PS_BlurV(PS_INPUT IN) : COLOR0
{
	float4 result = float4(0, 0, 0, 0);

	float2 size = cvBloomParams.zw;

	for (int i = 0; i < 32; ++i)
	{
		result += tex2D(DIFFUSEMAP_SAMPLER, IN.uv + float2(0, OFFSETS[i]) / size) * WEIGHTS[i];
	}

	return result;
}

technique Blur
{
	pass p0
	{
		VertexShader = compile vs_3_0 VS_ScreenFilter();
		PixelShader = compile ps_3_0 PS_BlurH();
	}

	pass p1
	{
		VertexShader = compile vs_3_0 VS_ScreenFilter();
		PixelShader = compile ps_3_0 PS_BlurV();
	}
}